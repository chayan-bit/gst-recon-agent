{#- Port of the "GST Tax Invoice" print format (Print Format Builder, Jinja) of resilient-tech/india-compliance
    (GPL-3.0), india_compliance/gst_india/print_format/gst_tax_invoice/gst_tax_invoice.json @ f0c6bec.
    Kept: section order, labels, the custom HTML blocks (heading, billing address, PO/transporter, unpaid amount,
    item columns serial/HSN/description/qty/rate/amount, taxes, totals, in words, GST breakup table, company
    registration details with "Our GSTIN" at the foot, "Generated By/On"). Framework calls replaced by values;
    the frappe builder CSS is approximated in the <style> block (custom css copied from the format). -#}
<!doctype html><html><head><meta charset="utf-8"><link rel="stylesheet" href="_frappe_print.css">
<style>
@page { size: A4; margin: 12mm 10mm; }
p { font-size: 12px !important; word-break: break-all; margin: 0 !important; }
table { width: 100%; }
.section { border-bottom: 1px solid #d1d8dd; padding: 8px 0; } .section::after { content: ""; display: table; clear: both; }
.c40 { float: left; width: 40%; padding-right: 10px; } .c35 { float: left; width: 35%; padding-right: 10px; } .c25 { float: left; width: 25%; }
.field { margin-top: 6px; } .field .lbl { color: #555; display: inline-block; width: 110px; }
.paid_unpaid { border: 1px solid #d1d8dd; padding: 6px; text-align: center; }
.items th { background: #f3f3f3; } .items td, .items th { border: 1px solid #d1d8dd; padding: 4px 6px; font-size: 11px; }
.totals td { padding: 3px 6px; font-size: 11px; } .company-details td { padding: 2px 6px 2px 0; }
.breakup td, .breakup th { border: 1px solid #d1d8dd; padding: 3px 5px; font-size: 10.5px; text-align: right; }
.breakup th { background: #f3f3f3; text-align: center; }
</style></head><body><div class="print-format">
<table><tbody><tr>
  <td style="padding: 0px !important;"><div style="display: inline-block;"><h1><b> {{ s.name }}</b></h1></div></td>
  <td style="width: 26%;text-align:end"><h2 style="margin-top:10px !important"><b>{{ 'Credit Note' if is_cn else 'Tax Invoice' }}</b> <br /><small> {{ inv.invoice_no }} </small></h2></td>
</tr></tbody></table>

<div class="section">
  <div class="c40">
    <div style="padding-bottom:5px !important">
      <p>Billing and Shipping Address</p>
      <p><b>{{ b.name }}</b></p>
      <p>{{ b.address }}<br>{{ state(b.state_code) }}, India<br>GSTIN: {{ b.gstin }}</p>
    </div>
    <div class="field"><span class="lbl">Place of Supply</span> {{ inv.place_of_supply }}-{{ state(inv.place_of_supply) }}</div>
    <div class="field"><span class="lbl">Reverse Charge</span> {{ 'Yes' if inv.reverse_charge else 'No' }}</div>
    <div class="field"><span class="lbl">Date</span> {{ dmy(inv.invoice_date) }}</div>
  </div>
  <div class="c35">
    {% if x.po_no %}<div class="first_section_second_column"><p><b>Purchase Order Reference</b></p><p>{{ x.po_no }}</p></div>{% endif %}
    {% if x.transport %}<div class="first_section_second_column" style="margin-top:6px"><p><b>Transporter Details</b></p><p>{{ x.transport }}</p></div>{% endif %}
  </div>
  <div class="c25"><div class="paid_unpaid"><p><b>Unpaid Amount</b></p><p><b> {{ rupees(inv.total) }}</b></p></div></div>
</div>

<div class="section">
<table class="items"><thead><tr><th>Sr</th><th>HSN/SAC</th><th style="width:200px">Description</th><th class="text-right">Quantity</th><th class="text-right">Rate</th><th class="text-right">Amount</th></tr></thead>
<tbody>{% for l in inv.line_items %}<tr><td>{{ loop.index }}</td><td>{{ l.hsn }}</td><td>{{ l.description }}</td><td class="text-right">{{ '%g' % l.quantity }} {{ l.unit }}</td><td class="text-right">{{ rupees(l.unit_price) }}</td><td class="text-right">{{ rupees(l.taxable_value) }}</td></tr>{% endfor %}</tbody></table>
</div>

<div class="section">
  <div class="c40" style="width:50%"><div class="field"><span class="lbl">Due Date</span> {{ dmy(inv.invoice_date) }}</div></div>
  <div style="float:right; width:50%"><table class="totals">
    <tr><td>Total</td><td class="text-right">{{ rupees(inv.taxable_value) }}</td></tr>
    {% set r = inv.line_items[0].rate %}{% set rc = ' (RCM)' if inv.reverse_charge else '' %}
    {% if h.intra %}<tr><td>CGST{{ rc }} @ {{ '%g' % (r / 2) }}%</td><td class="text-right">{{ rupees(inv.cgst) }}</td></tr><tr><td>SGST{{ rc }} @ {{ '%g' % (r / 2) }}%</td><td class="text-right">{{ rupees(inv.sgst) }}</td></tr>
    {% else %}<tr><td>IGST{{ rc }} @ {{ '%g' % r }}%</td><td class="text-right">{{ rupees(inv.igst) }}</td></tr>{% endif %}
    {% if inv.reverse_charge %}<tr><td>Less: tax payable by recipient under reverse charge</td><td class="text-right">-{{ rupees(h.tax) }}</td></tr>{% endif %}
    <tr><td><b>Grand Total</b></td><td class="text-right"><b>{{ rupees(inv.total) }}</b></td></tr>
    <tr><td><b>Rounded Total</b></td><td class="text-right"><b>{{ rupees(inv.total) }}</b></td></tr>
    <tr><td colspan="2">In Words: INR {{ words(inv.total) }}.</td></tr>
  </table></div>
</div>

<div class="section">
<table class="breakup"><thead><tr><th rowspan="2">HSN/SAC</th><th rowspan="2">Taxable Amount</th>{% if h.intra %}<th colspan="2">CGST</th><th colspan="2">SGST</th>{% else %}<th colspan="2">IGST</th>{% endif %}</tr>
<tr>{% for _ in range(2 if h.intra else 1) %}<th>Rate</th><th>Amount</th>{% endfor %}</tr></thead>
<tbody>{% for l in inv.line_items %}<tr><td style="text-align:left">{{ l.hsn }}</td><td>{{ money(l.taxable_value) }}</td>
{% if h.intra %}<td>{{ '%g' % (l.rate / 2) }}%</td><td>{{ money(l.cgst) }}</td><td>{{ '%g' % (l.rate / 2) }}%</td><td>{{ money(l.sgst) }}</td>{% else %}<td>{{ '%g' % l.rate }}%</td><td>{{ money(l.igst) }}</td>{% endif %}</tr>{% endfor %}</tbody></table>
</div>

<div class="section" style="border-bottom:0">
<table class="company-details"><tr><td><p> <b>PAN :</b> {{ pan }}</p></td><td><p> <b>Our GSTIN :</b> {{ s.gstin }}</p></td></tr></table>
<table class="company-details"><tr><td><p><b>Generated By :</b> Accounts User</p></td></tr><tr><td><p><b>Generated On:</b> {{ dmy(inv.invoice_date) }} 10:12:41</p></td></tr></table>
</div>
</div></body></html>
